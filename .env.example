# JDoodle API Credentials
# Sign up for FREE at: https://www.jdoodle.com/compiler-api

# Paste your credentials here:
JDOODLE_CLIENT_ID=your_client_id_here
JDOODLE_CLIENT_SECRET=your_client_secret_here

# Instructions:
# 1. Go to https://www.jdoodle.com/compiler-api
# 2. Click "Subscribe" and choose the FREE plan (200 requests/day)
# 3. Copy your Client ID and Client Secret
# 4. Replace the values above
# 5. Restart the server: npm run server

# Groq API Key
# Get a key at: https://console.groq.com/keys
# Add here and restart the server.
GROQ_API_KEY=gsk_your_actual_groq_key_here

# Optional: choose Groq model used for review/annotation
GROQ_MODEL=llama-3.1-8b-instant
